# Build output: cargo, Tauri, vite; tests and profiling write under target/ too.
**/target/
# Tauri writes generated schemas under gen/; the Android project there is kept
# (customised, and built as is on release), minus what its own .gitignore names.
apps/desktop/src-tauri/gen/*
!apps/desktop/src-tauri/gen/android/
node_modules/
dist/
apps/pwa/src/wasm/
**/fuzz/Cargo.lock
**/fuzz/corpus/
**/fuzz/artifacts/

# Local settings and secrets. `.env.example` is the committed template.
.env
.env.*
!.env.example
/config.toml
.cargo/
*.pem
*.key
*.crt
*.p12
*.keystore

# Mobile packages
*.apk
*.aab

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local AI tooling
CLAUDE.md
.claude/*
.claude_cache
.mcp.json
.agents/*
.aidesigner/*
.code-review-graph/
