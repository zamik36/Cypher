# Public domain served by Caddy (production).
DOMAIN=cypher.example.com

# Redis password (change in production).
REDIS_PASSWORD=changeme

# Per-service NATS passwords; permissions are defined in deploy/nats.conf.
GATEWAY_NATS_PASSWORD=changeme-gateway
SIGNALING_NATS_PASSWORD=changeme-signaling
RELAY_NATS_PASSWORD=changeme-relay

# Grafana admin password (production and monitoring overlays).
GRAFANA_PASSWORD=changeme-grafana

# Public host:port of the onion relay advertised to clients.
RELAY_PUBLIC_ADDR=localhost:9300

# Optional CA-issued certificates for the gateway and relay listeners.
# Without them a self-signed development certificate is generated.
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem
